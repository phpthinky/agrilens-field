<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android only grants USB access to a UVC (video) device to apps holding CAMERA. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Pulled in by the UVCAndroid library but not used by this app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- UVCAndroid declares usb.host as required; keep the app installable everywhere. -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false"
        tools:node="replace" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AgrilensField"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.DashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AssignmentListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AssignmentDetailActivity"
            android:exported="false" />

        <activity
            android:name=".ui.BarangayListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FarmerListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FarmListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.NewAnalysisChoiceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CreateAnalysisActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ColorimetricActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ResultWebViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <activity
            android:name=".ui.ScheduleAssignmentActivity"
            android:exported="false" />

        <activity
            android:name=".ui.TaskListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ProbeReadActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

    </application>
</manifest>
